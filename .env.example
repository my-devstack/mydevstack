CONFIG_FILE=./config.yaml
PROXY_PORT=8081
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY=test
AWS_SECRET_KEY=test
# Read-only mode: when true, all mutating proxy requests (POST/PUT/PATCH/DELETE)
# return 403, except POST /proxy/region. UI shows a read-only banner and disables
# create/edit/delete actions. Requires backend restart to change.
READ_ONLY_MODE=false